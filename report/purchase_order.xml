<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<template id="purchaseorder_document_energostech" inherit_id="l10n_co_reports_int.purchaseorder_document_inherit">
            <xpath expr="//div[@id='informations']" position="inside">
                <div t-if="o.x_comparativo">
                    <strong>No. Comparativo:</strong>
                    <span t-field="o.x_comparativo" class="m-0"/>
                </div> 
            </xpath>
            <xpath expr="//div[@class='container']/div/div[1]" position="replace">
                <div class="col-4">
                    <b>Dirección de Envío:</b><br/>
                    <t t-if="o.x_direccion_env">                                                 
                        <span t-field="o.x_direccion_env"/>
                    </t>
                </div>
            </xpath>
            <xpath expr="//div[@id='total']" position="after">
                <div class="row" style="margin-top:30px">
                    <div align="center" class="col-4">
                        _____________________________________<br/>
                        COORDINADOR DE COMPRAS
                    </div>
                    <div align="center" class="col-4">
                        _____________________________________<br/>
                        GERENTE
                    </div>
                </div>
            </xpath>
		</template>
    </data>
</odoo>
           
